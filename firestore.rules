rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // One document per player: users/{uid}. Only the signed-in owner can read or write it.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validProgress() {
        let d = request.resource.data;
        return d.keys().hasOnly(['mileage', 'totalRuns', 'highScores', 'selectedCharacter', 'featherLives',
                                 'bgmVolume', 'sfxVolume', 'displayName', 'provider', 'createdAt', 'updatedAt',
                                 'nickname', 'accountId', 'expireAt'])
          && d.mileage is int && d.mileage >= 0
          && d.totalRuns is int && d.totalRuns >= 0
          && d.highScores is map
          && d.displayName is string && d.displayName.size() <= 120
          && (!('nickname' in d) || (d.nickname is string && d.nickname.size() <= 12))
          && (!('accountId' in d) || (d.accountId is string && d.accountId.size() <= 120))
          && (!('expireAt' in d) || d.expireAt is timestamp);
      }

      allow read: if isOwner();
      allow create, update: if isOwner() && validProgress();
      allow delete: if false;
    }

    // Admin list: one document per admin, named after the login email in lower case
    // (phone accounts: {countryCode}-{number}@phone.chickenrunv2.app). Managed only in the Firebase console;
    // a signed-in user can read just the document for their own email, so the list itself stays private.
    match /admins/{email} {
      allow read: if request.auth != null
                  && request.auth.token.firebase.sign_in_provider == 'password'
                  && request.auth.token.email == email;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
